---
import Menu from "../components/Menu.astro";
import Layout from "../layouts/Layout.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Main from "../components/Main.astro";
import CTA from "../components/CTA.astro";
import ContactUs from "../components/ContactUs.astro";
import Footer from "../components/Footer.astro";

---

<Layout title="Mobilmend">
  <section
    class="space-y-2 pt-10 w-full h-screen flex flex-col items-center justify-center dark:bg-gray-700 dark:text-white text-white"
  >
    <Main/>
  </section>

  <section
    class="w-full h-screen bg-gradient-to-b from-gray-700 to-white p-5 flex flex-row items-center justify-center"
  >
    <About/>
  </section>

  <section class="w-full h-auto py-32 flex flex-col items-center justify-center bg-white">
    <Services/>
    <CTA />
  </section>

  <section class="w-full h-screen flex flex-col items-center justify-between">
    <ContactUs/>
  </section>

  <Footer />
  
</Layout>

