---
import Menu from "../components/Menu.astro";
import Layout from "../layouts/Layout.astro";
import Services from "../components/Services.astro";
import About from "../components/About.astro";
import Main from "../components/Main.astro";
import CTA from "../components/CTA.astro";
import ContactUs from "../components/ContactUs.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Mobilmend">
  <section
    class="w-full min-h-screen h-full flex flex-col space-y-4 px-6 py-20 items-center justify-center sm:justify-start bg-gray-700 pt-28"
  >
    <Main />
  </section>

  <section
    class="w-full min-h-screen h-full bg-gradient-to-b from-gray-700 to-white p-5 flex flex-row items-center justify-center"
  >
    <About />
  </section>

  <section
    class="w-full h-auto py-10 flex flex-col items-center justify-center bg-white"
  >
    <Services />
    <CTA />
  </section>

  <section
    class="w-full h-full md:h-screen flex flex-col space-y-2 items-center justify-between bg-white px-8"
    id="contact"
  >
    <ContactUs />
  </section>

  <Footer />
</Layout>

