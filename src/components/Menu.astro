        <!-- <i class="fa-solid fa-xmark"></i> -->
      </button>
    </div>
    <div id="container" class="mx-auto items-center hidden w-full md:h-auto md:flex md:w-auto md:order-1" id="navbar-sticky">
      <ul class="flex gap-5 md:gap-0 flex-col h-full items-center md:justify-normal p-4 md:p-0 mt-4 font-medium border rounded-lg md:space-x-14 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0">
        <li>
          <a href="#" class="block py-2 px-3 w-24 items-center justify-center text-center text-white rounded bg-blue-700 md:p-0" aria-current="page">Home</a>
        </li>
        <li class="">
          <a href="#" class="block py-2 px-3 w-24 items-center justify-center text-center text-white rounded hover:bg-blue-700 md:p-0">Services</a>
        </li>
        <li>
          <a href="#" class="block py-2 px-3 w-24 items-center justify-center text-center text-white rounded hover:bg-blue-700 md:p-0">Contact</a>
        </li>
      </ul>
    </div>
  </div>
