---
import Card from "./Card.astro";

const cards = [
  {
    titulo: "Telefono",
    descripcion: "+58 4125488569",
    svg: "fa-solid fa-phone",
    icons: undefined,
  },
  {
    titulo: "Direccion",
    descripcion: "Calle 1, avenida principal",
    svg: "fa-solid fa-location-crosshairs",
    icons: undefined,
  },
  {
    titulo: "Redes",
    svg: "fa-solid fa-hashtag",
    icons: [
      {icon: "fa-brands fa-facebook", url: "https://www.facebook.com"},
      {icon: "fa-brands fa-instagram", url: "https://www.instagram.com"},
      {icon: "fa-brands fa-whatsapp", url: "https://www.wa.me"},
    ],

  },
];
---

  <div class="flex flex-col items-center space-y-2 pt-10">
    <h2 class="text-3xl font-semibold">Contactanos</h2>
    <p class="text-sm sm:text-base text-center text-black">
      Estamos aqui para ayudarte, envianos tus consultas
    </p>
  </div>

  <form
    class="w-full md:9/12 lg:w-8/12 h-4/6 border-2 border-gray-200 hover:border-blue-500 p-5 rounded flex flex-col justify-around"
    action=""
  >
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-0 md:gap-7">
      <div class="flex flex-col space-y-2 w-full">
        <label for="Nombre">Nombre</label>
        <input
          type="text"
          class="shadow-sm appearance-none border border-gray-200 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          name=""
          id="Nombre"
          placeholder="Ingresa tu nombre"
        />
      </div>

      <div class="flex flex-col space-y-2 w-full">
        <label for="Correo">Correo electronico</label>
        <input
          type="text"
          class="shadow-sm appearance-none border border-gray-200 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
          name=""
          id="Correo"
          placeholder="Ingresa tu correo"
        />
      </div>
    </div>

    <div class="flex flex-col space-y-2">
      <label for="Asunto">Asunto</label>
      <input
        type="text"
        class="shadow-sm appearance-none border border-gray-200 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
        name=""
        id="Asunto"
        placeholder="Escribe tu asunto"
      />
    </div>

    <div class="flex flex-col space-y-2 h-2/6">
      <label for="Mensaje">Mensaje</label>
      <textarea
        class="shadow-sm appearance-none border border-gray-200 rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent h-5/6 resize-none"
        name=""
        id="Mensaje"
        placeholder="Escribe tu mensaje"></textarea>
    </div>
    <button
      class="w-full text-center bg-blue-500 hover:bg-blue-600 text-white p-2 rounded-md"
      type="button"
    >
      Enviar
    </button>
  </form>

  <div class="w-full h-3/6 py-4 smCustom:h-2/6 grid grid-cols-1 smCustom:grid-cols-2 md:grid-cols-3 gap-x-6 my-10 smCustom:my-0 smCustom:items-center smCustom:justify-items-center">
    {cards.map((elemento) => (
      <Card
        titulo={elemento.titulo}
        descripcion={elemento.descripcion}
        svg={elemento.svg}
        icons={elemento.icons}
      />
    ))}
  </div>
  
  
  
