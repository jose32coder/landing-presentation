---
import Card from "./Card.astro"
---

    <div class="flex flex-col items-center gap-0">
      <h2 class="text-2xl font-semibold">Contactanos</h2>   
      <p class="text-md text-gray-600">Estamos aqui para ayudarte, envianos tus consultas</p>
     </div>

   <form class="mt-5 w-6/12 h-4/6 border-2 border-gray-100 p-5 rounded flex flex-col justify-around" action="">
     
     <div class="grid grid-cols-2 gap-3">

       <div class="flex flex-col w-full">
         <label for="Nombre">Nombre</label>
         <input type="text" class="shadow-sm appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" name="" id="Nombre" placeholder="Ingresa tu nombre">
       </div>

       <div class="flex flex-col w-full">
         <label for="Correo">Correo electronico</label>
         <input type="text" class="shadow-sm appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" name="" id="Correo" placeholder="Ingresa tu correo">
       </div>
     </div>

     <div class="flex flex-col">
       <label for="Asunto">Asunto</label>
       <input type="text" class="shadow-sm appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent" name="" id="Asunto" placeholder="Escribe tu asunto">
     </div>

     <div class="flex flex-col h-2/6">
       <label for="Mensaje">Mensaje</label>
       <textarea class="shadow-sm appearance-none border rounded w-full py-2 px-3 text-gray-700 leading-tight focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent h-5/6 resize-none border-gray-100" name="" id="Mensaje" placeholder="Escribe tu mensaje"></textarea>
     </div>
     <button class="w-full text-center bg-blue-500 hover:bg-blue-600 text-white p-2 rounded-md" type="button">
       Enviar
     </button>
   </form>

   <div class="w-full h-2/6 flex items-center justify-around">
     <Card titulo="Telefono" descripcion="+58 4125488569" svg="img/block.svg"/>
     <Card titulo="Direccion" descripcion="Calle 1, avenida principal" svg="img/money.svg"/>
     <Card titulo="Quetal" descripcion="ejemplo 03" svg="img/location.svg"/>
   </div>