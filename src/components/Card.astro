---
interface Props {
	titulo: string;
	svg: string;
	descripcion: string;
}
const { titulo, svg, descripcion } = Astro.props;
---


<div class="bg-white bg-button group shadow-button hover:shadow-button-hover hover:scale-110 transition-all duration-300 flex flex-col justify-around py-2 px-4 w-3/12 h-3/6 rounded shadow-sm appearance-none border">
    <div class="flex items-center justify-between ">
        <h2 class="font-semibold">{titulo}</h2>
        <img src={svg} alt="" class="transition duration-300 ease-in-out">
    </div>
    <p class="text-sm text-gray-600">{descripcion}</p>

</div>